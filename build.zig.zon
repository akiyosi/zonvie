.{
    .name = .zonvie,
    .version = "0.0.0",

    .fingerprint = 0x27bbe734fac1eb4,

    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        .@"zig-toml" = .{
            .url = "git+https://github.com/sam701/zig-toml?ref=zig-0.16#8685923e32e8b8a795eb2715684236975a70faed",
            .hash = "toml-0.3.0-bV14BRmKAQAWR0FT0KUKFwVJTImaFhWjSe6HfSMtNZOH",
        },
        // Vendored fork of Games-by-Mason's glslang-zig (originally
        // git+.../glslang-zig#734f197). Upstream has no Zig 0.16 port — its
        // build.zig still uses the 0.15 build API — so the package is vendored
        // under pkg/glslang/ with its build.zig migrated to the 0.16 build API
        // (Compile->Module link methods). The upstream KhronosGroup/glslang +
        // SPIRV-Tools + SPIRV-Headers C++ sources are still pulled as transitive
        // deps (declared in pkg/glslang/build.zig.zon) and need no patching.
        .glslang = .{
            .path = "pkg/glslang",
        },
        // Local thin build wrapper around KhronosGroup/SPIRV-Cross.
        // No public Zig-0.15-compatible port exists, so we vendor our own
        // (under pkg/spirv_cross/). It fetches the upstream sources via
        // Zig's package manager, so there is no git submodule to manage.
        .spirv_cross = .{
            .path = "pkg/spirv_cross",
        },
    },

    .paths = .{""},
}
